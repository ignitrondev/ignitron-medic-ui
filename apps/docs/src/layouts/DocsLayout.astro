---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#09090b" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('ignitron-docs-theme');
        const theme = stored === 'light' || stored === 'dark'
          ? stored
          : window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/" aria-label="Ignitron Clinical UI documentation home">
        <span class="brand-mark"><img src="/images/ignitron.png" alt="" /></span>
        <span class="brand-copy">
          <b>Ignitron<span>Dev</span></b>
          <small>CLINICAL UI / DOCS</small>
        </span>
      </a>

      <div class="topbar-actions">
        <span class="release"><i></i> ALPHA 0.1</span>
        <a href="https://github.com/ignitrondev/ignitron-medic-ui" target="_blank" rel="noreferrer">
          GitHub
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 17 17 7M7 7h10v10" /></svg>
        </a>
        <button class="theme-toggle" type="button" aria-label="Switch color theme">
          <svg class="theme-sun" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.5" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" /></svg>
          <svg class="theme-moon" aria-hidden="true" viewBox="0 0 24 24"><path d="M20.5 15.4A8.5 8.5 0 0 1 8.6 3.5 8.5 8.5 0 1 0 20.5 15.4Z" /></svg>
        </button>
        <button class="menu-toggle" type="button" aria-label="Hide documentation sidebar" aria-expanded="true">
          <span></span><span></span>
        </button>
      </div>
    </header>

    <slot />

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const themeToggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const sidebar = document.querySelector<HTMLElement>('.docs-sidebar');
      const desktop = window.matchMedia('(min-width: 761px)');

      function updateThemeToggle() {
        const isDark = document.documentElement.dataset.theme === 'dark';
        themeToggle?.setAttribute('aria-label', `Switch to ${isDark ? 'light' : 'dark'} theme`);
      }

      themeToggle?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('ignitron-docs-theme', next);
        updateThemeToggle();
      });

      updateThemeToggle();

      function sidebarIsOpen() {
        return desktop.matches
          ? !document.body.classList.contains('sidebar-collapsed')
          : sidebar?.classList.contains('is-open') ?? false;
      }

      function updateToggle(open: boolean) {
        toggle?.setAttribute('aria-expanded', String(open));
        toggle?.setAttribute('aria-label', `${open ? 'Hide' : 'Show'} documentation sidebar`);
      }

      toggle?.addEventListener('click', () => {
        if (desktop.matches) {
          document.body.classList.toggle('sidebar-collapsed');
        } else {
          sidebar?.classList.toggle('is-open');
        }
        updateToggle(sidebarIsOpen());
      });

      const navigationLinks = Array.from(sidebar?.querySelectorAll<HTMLAnchorElement>('a[href^="#"]') ?? []);
      const sections = navigationLinks
        .map((link) => document.querySelector<HTMLElement>(link.hash))
        .filter((section): section is HTMLElement => section !== null);

      function setActiveSection(id: string) {
        navigationLinks.forEach((link) => {
          const active = link.hash === `#${id}`;
          link.classList.toggle('active', active);
          if (active) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      }

      navigationLinks.forEach((link) => {
        link.addEventListener('click', () => {
          setActiveSection(link.hash.slice(1));
          if (!desktop.matches) {
            sidebar?.classList.remove('is-open');
            updateToggle(false);
          }
        });
      });

      let scrollFrame = 0;
      function updateActiveFromScroll() {
        const marker = window.scrollY + window.innerHeight * 0.32;
        const current = sections.reduce((active, section) => (
          section.offsetTop <= marker ? section : active
        ), sections[0]);
        if (current) setActiveSection(current.id);
        scrollFrame = 0;
      }

      window.addEventListener('scroll', () => {
        if (scrollFrame === 0) scrollFrame = window.requestAnimationFrame(updateActiveFromScroll);
      }, { passive: true });

      desktop.addEventListener('change', () => {
        document.body.classList.remove('sidebar-collapsed');
        sidebar?.classList.remove('is-open');
        updateToggle(desktop.matches);
      });

      if (window.location.hash) setActiveSection(window.location.hash.slice(1));
      else updateActiveFromScroll();
      updateToggle(desktop.matches);

      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
        button.addEventListener('click', async () => {
          const value = button.dataset.copy;
          if (!value) return;
          await navigator.clipboard.writeText(value);
          const previous = button.textContent;
          button.textContent = 'Copied';
          window.setTimeout(() => { button.textContent = previous; }, 1400);
        });
      });
    </script>
  </body>
</html>
