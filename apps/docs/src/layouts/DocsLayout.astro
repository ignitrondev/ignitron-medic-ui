---
import Dot from '../components/Dot.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
---

<!doctype html>
<html lang="en" class="scroll-pt-25 scroll-smooth bg-space motion-reduce:scroll-auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#09090b" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ignitron Clinical UI" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('ignitron-docs-theme');
        const theme = stored === 'light' || stored === 'dark'
          ? stored
          : window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="min-w-80 bg-space font-sans leading-[1.6] text-ink antialiased">
    <header
      class="fixed inset-x-0 top-0 z-100 flex h-(--topbar) items-center justify-between border-b border-line bg-topbar px-[30px] backdrop-blur-[18px] max-desktop:px-[18px]"
    >
      <a class="inline-flex items-center gap-3" href="/" aria-label="Ignitron Clinical UI documentation home">
        <span class="grid size-[38px] place-items-center overflow-hidden bg-ink">
          <img class="size-[38px] object-cover" src="/images/ignitron.png" alt="" />
        </span>
        <span class="flex flex-col leading-[1.1]">
          <b class="text-[17px] tracking-[-0.025em]">Ignitron<span class="text-muted">Dev</span></b>
          <small class="mt-[5px] font-mono text-[8px] leading-natural font-medium tracking-[0.16em] text-dim">CLINICAL UI / DOCS</small>
        </span>
      </a>

      <div class="flex items-center gap-[22px]">
        <span
          class="inline-flex items-center gap-2 border border-line px-2.5 py-[7px] font-mono text-[10px] leading-natural font-medium tracking-[0.08em] text-muted max-desktop:hidden"
        >
          <Dot /> ALPHA 0.1
        </span>
        <a
          class="inline-flex items-center gap-2 font-mono text-[10px] leading-natural font-medium tracking-[0.08em] text-muted hover:text-ink max-desktop:hidden"
          href="https://github.com/ignitrondev/ignitron-medic-ui"
          target="_blank"
          rel="noreferrer"
        >
          GitHub
          <svg class="w-[15px] fill-none stroke-current stroke-[1.7]" aria-hidden="true" viewBox="0 0 24 24"><path d="M7 17 17 7M7 7h10v10" /></svg>
        </a>
        <button
          class="grid size-[38px] place-items-center border border-line bg-transparent text-muted hover:border-line-strong hover:bg-raised hover:text-ink"
          data-theme-toggle
          type="button"
          aria-label="Switch color theme"
        >
          <svg class="size-4 fill-none stroke-current stroke-[1.7] in-data-[theme=dark]:hidden" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.5" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" /></svg>
          <svg class="size-4 fill-none stroke-current stroke-[1.7] in-data-[theme=light]:hidden" aria-hidden="true" viewBox="0 0 24 24"><path d="M20.5 15.4A8.5 8.5 0 0 1 8.6 3.5 8.5 8.5 0 1 0 20.5 15.4Z" /></svg>
        </button>
        <button
          class="group grid size-[38px] place-content-center border border-line bg-transparent text-ink transition-all duration-[160ms] hover:border-line-strong hover:bg-raised"
          data-menu-toggle
          type="button"
          aria-label="Hide documentation sidebar"
          aria-expanded="true"
        >
          <span class="mx-auto my-[3px] block h-px w-4 bg-current transition-all duration-[160ms] group-aria-[expanded=false]:w-2.5 group-aria-[expanded=false]:-translate-x-[3px]"></span>
          <span class="mx-auto my-[3px] block h-px w-4 bg-current transition-all duration-[160ms] group-aria-[expanded=false]:w-2.5 group-aria-[expanded=false]:translate-x-[3px]"></span>
        </button>
      </div>
    </header>

    <slot />

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const sidebar = document.querySelector<HTMLElement>('[data-sidebar]');
      const desktop = window.matchMedia('(min-width: 761px)');

      function updateThemeToggle() {
        const isDark = document.documentElement.dataset.theme === 'dark';
        themeToggle?.setAttribute('aria-label', `Switch to ${isDark ? 'light' : 'dark'} theme`);
      }

      themeToggle?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('ignitron-docs-theme', next);
        updateThemeToggle();
      });

      updateThemeToggle();

      function sidebarIsOpen() {
        return desktop.matches
          ? !document.body.classList.contains('sidebar-collapsed')
          : sidebar?.classList.contains('is-open') ?? false;
      }

      function updateToggle(open: boolean) {
        toggle?.setAttribute('aria-expanded', String(open));
        toggle?.setAttribute('aria-label', `${open ? 'Hide' : 'Show'} documentation sidebar`);
      }

      toggle?.addEventListener('click', () => {
        if (desktop.matches) {
          document.body.classList.toggle('sidebar-collapsed');
        } else {
          sidebar?.classList.toggle('is-open');
        }
        updateToggle(sidebarIsOpen());
      });

      const navigationLinks = Array.from(sidebar?.querySelectorAll<HTMLAnchorElement>('a[href^="#"]') ?? []);
      const breadcrumbGroup = document.querySelector<HTMLElement>('[data-breadcrumb-group]:not(a)');
      const breadcrumbPage = document.querySelector<HTMLElement>('[data-breadcrumb-page]');
      const sections = navigationLinks
        .map((link) => document.querySelector<HTMLElement>(link.hash))
        .filter((section): section is HTMLElement => section !== null);

      function setActiveSection(id: string) {
        navigationLinks.forEach((link) => {
          const active = link.hash === `#${id}`;
          if (active) {
            link.setAttribute('aria-current', 'location');
            if (breadcrumbGroup) breadcrumbGroup.textContent = link.dataset.breadcrumbGroup ?? '';
            if (breadcrumbPage) breadcrumbPage.textContent = link.dataset.breadcrumbLabel ?? '';
          } else link.removeAttribute('aria-current');
        });
      }

      navigationLinks.forEach((link) => {
        link.addEventListener('click', () => {
          setActiveSection(link.hash.slice(1));
          if (!desktop.matches) {
            sidebar?.classList.remove('is-open');
            updateToggle(false);
          }
        });
      });

      let scrollFrame = 0;
      function updateActiveFromScroll() {
        const marker = window.scrollY + window.innerHeight * 0.32;
        const current = sections.reduce((active, section) => (
          section.offsetTop <= marker ? section : active
        ), sections[0]);
        if (current) setActiveSection(current.id);
        scrollFrame = 0;
      }

      window.addEventListener('scroll', () => {
        if (scrollFrame === 0) scrollFrame = window.requestAnimationFrame(updateActiveFromScroll);
      }, { passive: true });

      desktop.addEventListener('change', () => {
        document.body.classList.remove('sidebar-collapsed');
        sidebar?.classList.remove('is-open');
        updateToggle(desktop.matches);
      });

      if (window.location.hash) setActiveSection(window.location.hash.slice(1));
      else updateActiveFromScroll();
      updateToggle(desktop.matches);

      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
        button.addEventListener('click', async () => {
          const value = button.dataset.copy;
          if (!value) return;
          await navigator.clipboard.writeText(value);
          const previous = button.textContent;
          button.textContent = 'Copied';
          window.setTimeout(() => { button.textContent = previous; }, 1400);
        });
      });
    </script>
  </body>
</html>
