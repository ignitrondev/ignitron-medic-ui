  "description": "Configurable React odontogram with a framework-independent clinical data model.",
  "license": "Apache-2.0",
  "author": "IgnitronDev",
  "homepage": "https://ignitron-medic-ui.pages.dev/",
  "repository": {
    "type": "git",
